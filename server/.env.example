# Nusxa oling: server/.env  (bu fayl git'ga qo'shilmaydi)

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Ishlab chiqishda PostgreSQL o'rnatish shart emas: ichki PGlite fayl bazasi ishlatiladi.
# Production: DATABASE_URL=postgres://yuim:parol@localhost:5432/yuim
DATABASE_URL=pglite:./.data/pglite

# Production'da majburiy, kamida 32 belgi. Yaratish: node -e "console.log(crypto.randomBytes(48).toString('base64'))"
JWT_SECRET=

# Rolni tanlab parolsiz kirish (namoyish). Production'da sukut bo'yicha false.
DEMO_LOGIN=true

# npm run db:seed yaratadigan test foydalanuvchilar paroli (loginlar: admin, menejer, komplayens,
# investitsiya, yuridik, audit, investor, biznes). Faqat test muhit uchun!
SEED_PASSWORD=yuim-test-parol

# HTTPS orqali ishlaganda true (production'da sukut bo'yicha true)
COOKIE_SECURE=false

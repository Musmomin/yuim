{
  "name": "yuim-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/db/seed-cli.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/jwt": "10.2.9",
    "@fastify/rate-limit": "11.3.0",
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.10",
    "@types/pg": "8.23.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "5.8.3",
    "vitest": "5.1.1"
  }
}
